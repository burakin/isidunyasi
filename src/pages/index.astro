---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const featured=posts.find(p=>p.data.featured)||posts[0];
const rest=posts.filter(p=>p.id!==featured.id);
const categories=['Tümü',...new Set(posts.map(p=>p.data.category))];
const base=import.meta.env.BASE_URL;
---
<Base><section class="intro shell"><div class="eyebrow"><span class="live-dot"></span> EVİNİZİN ENERJİ REHBERİ <span class="eyebrow-line"></span> TÜRKİYE</div><h1>Isınmanın<br/><em>yeni dünyası.</em></h1><div class="intro-bottom"><p>Isı pompalarından enerji tasarrufuna, eviniz için doğru kararları almanızı sağlayan sade ve güvenilir içerikler.</p><a href="#yazilar" class="circle-down" aria-label="Yazılara git">↓</a></div></section><section class="shell hero-feature"><a class="hero-image" href={`${base}yazilar/${featured.id}/`}><img src={featured.data.image} alt={featured.data.imageAlt||featured.data.title}/><span class="hero-overlay"></span><span class="hero-label">ÖNE ÇIKAN YAZI <span>↗</span></span><div class="hero-text"><span>{featured.data.category} <span class="meta-dot">•</span> {featured.data.readTime||6} DAKİKA OKUMA</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p></div></a></section><section class="shell content-section" id="yazilar"><div class="section-top"><div><span class="section-kicker">BİLGİ MERKEZİ / 01</span><h2>Merak ettikleriniz,<br/><em>burada.</em></h2></div><p>Teknik konuları herkes için anlaşılır hale getiriyoruz. Araştırın, karşılaştırın, keşfedin.</p></div><div class="filters" id="kategoriler"><div class="category-buttons" aria-label="Yazı kategorileri">{categories.map(c=><button class="filter-btn" data-category={c} aria-pressed={c==='Tümü'}>{c}</button>)}</div><label class="search-field"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input id="article-search" type="search" placeholder="Yazılarda ara..." aria-label="Yazılarda ara"/></label></div><div class="article-grid" id="article-grid">{posts.map(p=><div class="filterable" data-category={p.data.category} data-search={`${p.data.title} ${p.data.description} ${p.data.category}`.toLocaleLowerCase('tr-TR')}><ArticleCard post={p}/></div>)}</div><p class="no-results" id="no-results" hidden>Aramanızla eşleşen yazı bulunamadı.</p></section><section class="about-band" id="hakkimizda"><div class="shell about-inner"><div><span class="section-kicker">NEDEN ISI DÜNYASI?</span><h2>Doğru bilgi.<br/><em>Daha iyi kararlar.</em></h2></div><div><p>Isıtma teknolojileri karmaşık olmak zorunda değil. Isı Dünyası, Türkiye'deki ev sahiplerine ısı pompalarını, maliyetleri ve verimliliği anlaşılır biçimde anlatmak için oluşturulmuş bağımsız bir içerik projesidir.</p><a href="#yazilar">İçerikleri keşfet ↗</a></div></div></section><script>const buttons=[...document.querySelectorAll('.filter-btn')];const cards=[...document.querySelectorAll('.filterable')];const search=document.querySelector('#article-search');let category='Tümü';function update(){const q=(search?.value||'').trim().toLocaleLowerCase('tr-TR');let shown=0;cards.forEach(c=>{const ok=(category==='Tümü'||c.dataset.category===category)&&(!q||c.dataset.search?.includes(q));c.hidden=!ok;if(ok)shown++;});const empty=document.querySelector('#no-results');if(empty)empty.hidden=shown!==0;}buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category||'Tümü';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));update();}));search?.addEventListener('input',update);</script></Base>
