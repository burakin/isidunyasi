---
const {post,large=false}=Astro.props;
const d=post.data;
const base=import.meta.env.BASE_URL;
---
<a class:list={['article-card',{'article-card-large':large}]} href={`${base}yazilar/${post.id}/`}><div class="card-image"><img src={d.image} alt={d.imageAlt || d.title} loading="lazy"/><span class="image-arrow" aria-hidden="true">↗</span></div><div class="card-meta"><span>{d.category}</span><span class="meta-dot">•</span><time datetime={d.date.toISOString()}>{d.date.toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'})}</time></div><h3>{d.title}</h3><p>{d.description}</p><span class="read-link">Yazıyı oku <span aria-hidden="true">↗</span></span></a>
